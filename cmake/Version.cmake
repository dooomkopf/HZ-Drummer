# Writes the program version into a header, on every build: v0.2.<number of commits>.
# The file only changes when the number does, so nothing is recompiled without a new commit.
# Called with -DSOURCE_DIR=... -DOUTPUT=...
execute_process(COMMAND git rev-list --count HEAD
                WORKING_DIRECTORY ${SOURCE_DIR}
                OUTPUT_VARIABLE COMMITS
                OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE RESULT
                ERROR_QUIET)
if(NOT RESULT EQUAL 0 OR COMMITS STREQUAL "")
    set(COMMITS "0")   # no git (source archive): still builds
endif()

set(CONTENT "#pragma once\n// Generated by cmake/Version.cmake on every build, do not edit\n#define HZ_VERSION \"0.2.${COMMITS}\"\n")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} OLD)
endif()
if(NOT "${OLD}" STREQUAL "${CONTENT}")
    file(WRITE ${OUTPUT} "${CONTENT}")
endif()
